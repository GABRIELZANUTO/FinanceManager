# Copy to .env and adjust. Values set in the real environment win over this file.

# Required unless DEBUG=1. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

# Development only. Leave unset (off) in production.
DEBUG=0

# Comma separated host names the site is served from.
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma separated origins (with scheme) for HTTPS sites behind a proxy, e.g. https://money.example.com
CSRF_TRUSTED_ORIGINS=

# SQLite file location (defaults to db.sqlite3 in the project root).
# DATABASE_PATH=/var/lib/finance-manager/db.sqlite3

LANGUAGE_CODE=pt-br
TIME_ZONE=America/Sao_Paulo

# Default overdraft policy; each user can override it in Settings.
ALLOW_NEGATIVE_BALANCE=1
ALLOW_REGISTRATION=1
DEFAULT_CURRENCY_CODE=BRL
DEFAULT_CURRENCY_SYMBOL=R$
# intl = 1,234.56 | indian = 12,34,567.89 | eu = 1.234,56 (Brazil) | space = 1 234,56
DEFAULT_NUMBER_FORMAT=eu

# Brute force protection for the login form.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
REGISTER_MAX_PER_HOUR=10

# HTTPS hardening (defaults are on when DEBUG is off).
# SECURE_SSL_REDIRECT=1
# SECURE_HSTS_SECONDS=31536000
# Set to 1 only behind a proxy that always sets X-Forwarded-Proto.
# TRUST_X_FORWARDED_PROTO=0

# Credit card statements: PDF files (and CSV layouts the app does not know) are read
# by Claude through the Anthropic API. Leave empty to use only the native Nubank CSV.
ANTHROPIC_API_KEY=
# INVOICE_AI_MODEL=claude-opus-5-5
# INVOICE_AI_EFFORT=high

# API (/api/v1/): requests per key per window (seconds).
# API_TOKEN_RATE=600
# API_TOKEN_WINDOW=60

# Synchronisation with the phone app: require Profile.plan = "sync" (billing not decided).
# SYNC_REQUIRE_PLAN=0
# Default site of the phone app (better in expensemanager/local_settings.py).
# SYNC_SERVER_URL=https://seu-site.exemplo.com

# Daily backup to Google Drive (scripts/autorizar_google_drive.py writes these three).
# GDRIVE_CLIENT_ID=
# GDRIVE_CLIENT_SECRET=
# GDRIVE_REFRESH_TOKEN=
# GDRIVE_FOLDER=Finanças Pessoais (backups)
# GDRIVE_KEEP=30
# GDRIVE_BACKUP_HOUR=3
